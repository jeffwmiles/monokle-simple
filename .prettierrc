{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "printWidth": 120,
  "importOrder": [
    "^@kubernetes?.+$",
    "^electron?.+$",
    "^react?.+$",
    "^antd?.+$",
    "^@ant-design?.+$",
    "^@reduxjs?.+$",
    "^@rjsf?.+$",
    "^(?![@\\.]).+$",
    "^@constants",
    "^@models",
    "^@redux",
    "^@organisms",
    "^@molecules",
    "^@atoms",
    "^@components",
    "^@hooks",
    "^@utils",
    "^@assets",
    "^@styles",
    "^@src",
    "^@.+$",
    "^(?!\\.+\\/styled)^[./]?.+$",
    "^\\.+\\/styled$"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderSideEffects": false,
  "importOrderParserPlugins": ["typescript", "jsx"],
  "singleQuote": true,
  "arrowParens": "avoid",
  "bracketSpacing": false,
  "semi": true,
  "trailingComma": "es5",
  "bracketSameLine": false,
  "proseWrap": "always",
  "quoteProps": "as-needed",
  "tabWidth": 2,
  "useTabs": false
}

{
  "name": "monokle",
  "version": "2.4.8",
  "author": "Kubeshop",
  "description": "Desktop IDE for local Helm templating and YAML configuration validation",
  "homepage": "./",
  "main": "build/electron/main.mjs",
  "contributors": [
    "ole@kubeshop.io",
    "steen@kubeshop.io",
    "andrei@kubeshop.io",

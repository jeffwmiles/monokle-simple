    "@kubernetes/client-node": "2.0.0",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/analytics-node": "3.1.14",
    "@types/async": "3.2.26",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/luxon": "3.7.6",
    "@types/micromatch": "4.0.10",
    "@types/node": "26.6.4",
    "@types/numeral": "2.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/redux-logger": "3.0.13",
    "@types/semver": "7.8.0",
    "@types/shelljs": "0.10.0",
    "@types/yargs": "17.0.35",
    "@vitejs/plugin-react": "6.1.2",
    "allotment": "1.20.5",
    "builder-util-runtime": "9.7.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "default-shell": "2.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "less": "4.9.1",
    "lint-staged": "17.6.0",
    "playwright": "1.63.0",
    "postcss": "8.5.29",
    "postcss-styled-syntax": "0.7.3",
    "prettier": "3.9.9",
    "standard-version": "9.5.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "wait-on": "9.5.1",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0",
    "xvfb-maybe": "0.2.1"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@electron/asar": "4.3.1",
    "@emotion/is-prop-valid": "1.4.0",
    "@monaco-editor/react": "4.7.0",
    "@monokle/validation": "0.33.0",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@reduxjs/toolkit": "2.13.0",
    "@rjsf/antd": "6.11.0",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@sentry/electron": "8.1.0",
    "@simbathesailor/use-what-changed": "2.0.0",
    "@tanstack/react-virtual": "3.14.13",
    "@trodi/electron-splashscreen": "1.0.3",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "analytics-node": "6.2.0",
    "antd": "6.6.5",
    "async": "3.2.6",
    "chokidar": "5.0.0",
    "electron-devtools-installer": "4.0.0",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "elkjs": "0.12.0",
    "execa": "10.0.1",
    "fast-json-stable-stringify": "2.1.0",
    "flat": "6.0.1",
    "framer-motion": "14.0.0",
    "fs-extra": "11.4.1",
    "html-to-image": "1.11.13",
    "json-schema-faker": "0.6.3",
    "jspdf": "4.2.1",
    "lodash": "4.18.1",
    "loglevel": "1.9.2",
    "luxon": "3.7.2",
    "micromatch": "4.0.8",
    "monaco-editor": "0.57.0",
    "monaco-yaml": "5.5.1",
    "new-github-issue-url": "1.1.0",
    "node-machine-id": "1.1.12",
    "numeral": "2.0.6",
    "openai": "7.28.0",
    "polished": "4.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-fast-compare": "3.2.2",
    "react-hotkeys-hook": "5.3.3",
    "react-markdown": "10.1.0",
    "react-redux": "9.3.0",
    "react-resizable": "4.0.2",
    "react-use": "17.6.1",
    "redux": "5.0.1",
    "redux-logger": "3.0.6",
    "redux-thunk": "3.1.0",
    "remark-gfm": "4.0.1",
    "reselect": "5.3.0",
    "runtypes": "7.0.5",
    "semver": "7.8.5",
    "strip-ansi": "7.2.0",
    "styled-components": "6.5.3",
    "tar": "7.5.22",
    "text-extensions": "3.1.0",
    "tiny-invariant": "1.3.3",
    "type-fest": "5.10.0",
    "uuid": "14.0.2",
    "vm2": "3.12.2",
    "web-vitals": "6.2.3",
    "yaml": "2.9.1",
    "yargs": "18.2.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "npm run electron:dev",
    "build": "vite build && node scripts/build-electron.cjs",
    "test": "jest --runInBand",
    "deps:audit": "node scripts/audit-dependencies.cjs",
    "postinstall": "electron-builder install-app-deps",
    "electron:dev": "concurrently -k \"vite\" \"node scripts/build-electron.cjs --watch --run\"",
    "electron:debug": "concurrently -k \"vite\" \"node scripts/build-electron.cjs --watch --run --debug\"",
    "electron:build": "npm run build && electron-builder --publish \"never\"",
    "electron:package:win": "electron-builder --win nsis --x64 --publish never",
    "electron:package:win:dir": "electron-builder --win --x64 --dir --publish never",
    "electron:build:mac": "npm run build && electron-builder --publish \"never\"",
    "electron:build:ci": "npm run build",
    "lint": "biome lint .",
    "stylelint": "stylelint \"src/**/*.{css,ts,tsx}\" --allow-empty-input",
    "lint:config": "biome lint biome.json tsconfig.json electron/tsconfig.json jest.config.cjs playwright.config.ts commitlint.config.mjs .husky/lint-staged.config.mjs",
    "lint:src": "biome lint src electron tests",
    "prepush": "npm run lint",
    "format:all": "prettier --write \"{src,electron,tests}/**/*.{js,jsx,ts,tsx,css}\"",
    "prepare": "husky",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "ui-test": "playwright test",
    "custom-script": "npx ts-node src/scripts/index.ts",
    "sign-dev-electron-app": "codesign --deep --force --verbose --sign - node_modules/electron/dist/Electron.app"
  },
  "build": {
    "appId": "io.kubeshop.monokle",
    "productName": "Monokle",
    "copyright": "Copyright © 2023 ${author}",
    "mac": {
      "notarize": false,
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "./electron/entitlements.mac.inherit.plist",
      "entitlementsInherit": "./electron/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "default",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "afterSign": "./notarization/afterSignHook.js",
    "dmg": {
      "icon": "build/icon.png",
      "writeUpdateInfo": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "sign": "./sign/customSign.js",
        "publisherName": [
          "Kubernetes Innovation Labs, LLC",
          "KUBERNETES INNOVATION LABS, LLC"
        ]
      }
    },
    "nsis": {
      "menuCategory": "Kubeshop",
      "shortcutName": "Monokle",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "oneClick": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "differentialPackage": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Kubeshop",
      "vendor": "Kubeshop",
      "executableName": "Monokle",
      "synopsis": "Desktop IDE for Kubernetes"
    },
    "appImage": {
      "artifactName": "${productName}-${os}-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageCategory": "Kubeshop",
      "priority": "standard"
    },
    "rpm": {
      "packageCategory": "Kubeshop"
    },
    "extends": null,
    "files": [
      "build/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}",
      "!**/node_modules/eslint*/**/*",
      "!**/node_modules/@testing-library/**/*",
      "!**/node_modules/@typescript-eslint/**/*",
      "!**/node_modules/typescript/**/*",
      "!**/node_modules/*webpack*/**/*",
      "!**/node_modules/less/**/*",
      "!**/node_modules/babel-runtime/**/*",
      "!**/node_modules/yaml-language-server/lib/umd/**/*",
      "!**/node_modules/antd/es/**/*",
      "!**/node_modules/@jest/**/*",
      "!**/node_modules/monaco-editor/min/**/*",
      "!**/node_modules/monaco-editor/min-maps/**/*",
      "!**/node_modules/commitlint/cli/**/*",
      "!**/node_modules/commitlint/config-conventional/**/*",
      "!**/node_modules/*playwright*/**/*",
      "!**/node_modules/@types/**/*",
      "!**/node_modules/babel-plugin-styled-components/**/*",
      "!**/node_modules/*eslint*/**/*",
      "!**/node_modules/*stylelint*/**/*",
      "!**/node_modules/*ts-jest*/**/*",
      "!**/docs/**/*",
      "!notarization/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "resources/darwin",
        "to": "app"
      },
      {
        "from": "resources",
        "to": "app"
      }
    ],
    "directories": {
      "buildResources": "assets"
    }
  },
  "lint-staged": {
    "{src,test}/**/*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      "last 1 chrome version"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}

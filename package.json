    "razvan@kubeshop.io"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/kubeshop/monokle.git"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=26.10.0 <27",
    "npm": ">=11.19.1 <12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",

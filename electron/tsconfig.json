{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "rootDir": "../",
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/types.d.ts"],
  "exclude": ["../node_modules", "../build", "../dist", "../.toolchain"],
  "extends": "../tsconfig.paths.json"
}
